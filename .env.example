# Generate a long random admin token. Never commit the real .env file.
BOU_ADMIN_TOKEN=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back up this key securely; losing it makes stored provider keys unreadable.
BOU_MASTER_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional desktop provider override. Normally save the key in desktop Settings instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
